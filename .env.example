# Copy this file to .env and fill in the values. .env is ignored by git.
#
# EXPO_PUBLIC_ variables are compiled INTO the app, so anyone with the APK can read them.
# That is fine for these two: the publishable key (sb_publishable_...) is designed to be
# public, and row-level security in the database decides what each user can see.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The secret key (sb_secret_...) bypasses row-level security. It is used ONLY on your own
# machine, by the access tests (npm run test:db) and the demo seed. It has no EXPO_PUBLIC_
# prefix, so Expo never puts it in the app. Never rename it, never commit it, never share it.
SUPABASE_SECRET_KEY=

# Password of the three demo accounts that npm run seed creates (inspector@, inspector2@ and
# supervisor@quartermaster.example). Optional: without it they get a random password nobody
# knows. Choose one that you do not use anywhere else.
DEMO_PASSWORD=
